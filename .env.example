# Shared Roblox OAuth configuration.
# Use a separate Roblox OAuth application/redirect registration per runtime when needed.
ROBLOX_OAUTH_CLIENT_ID=""

# Server-only client secret for Website / Vercel confidential client OAuth flow.
# Never configure this in the Electron desktop app or client-side bundles.
ROBLOX_OAUTH_CLIENT_SECRET=""

# Website / Vercel example (register this exact HTTPS URI in Roblox Creator Dashboard):
ROBLOX_OAUTH_REDIRECT_URI="https://your-production-domain.example/api/oauth/roblox/callback"

# Required only by the website/Vercel server. Generate at least 32 random bytes.
ROBLOX_OAUTH_SESSION_SECRET=""

# Electron development uses the same names above, but requires a loopback redirect instead:
# ROBLOX_OAUTH_REDIRECT_URI="http://127.0.0.1:53682/oauth/callback"

VITE_APP_NAME="Roblox Account Hub"
VITE_APP_VERSION="1.0.0"
VITE_DEFAULT_LOCALE="en-US"

# Do not put client secrets, access tokens, refresh tokens, cookies, PKCE verifiers,
# state values, or nonces in VITE_* variables.
